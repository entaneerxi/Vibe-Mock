@model IEnumerable<VibeMock.Models.Post>
@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<section class="hero-section" id="hero">
    <div class="container">
        <h1>Discover Luxury & Elegance</h1>
        <p>Experience the perfect blend of modern sophistication and timeless comfort</p>
        <a href="#posts" class="btn btn-lg">Explore Our World</a>
    </div>
</section>

<!-- Posts Section -->
<section id="posts" class="container">
    <h2 class="section-title">Featured Experiences</h2>
    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var post in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card card-custom">
                        <div class="card-body">
                            <span class="badge">@post.Category?.Name</span>
                            <h5 class="card-title">@post.Title</h5>
                            <p class="card-text">@post.Content</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">@post.Author</small>
                                <small class="text-muted">@post.CreatedDate.ToString("MMM dd, yyyy")</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center">
                    <h4>No experiences available</h4>
                    <p>Please check back soon for our latest offerings.</p>
                </div>
            </div>
        }
    </div>
</section>

<!-- Features Section -->
<section class="features-section">
    <div class="container">
        <h2 class="section-title">Why Choose Us</h2>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="feature-box">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="#c9a961" viewBox="0 0 16 16">
